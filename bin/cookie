#!/bin/sh
# SPDX-License-Identifier: 0BSD
# cookie - scale any recipe's LOD0 table to a batch or a single portion.
# Default recipe: recipes/core-recipe-v0.1.md. Override with RECIPE=path/to/recipe.md.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/bin/lib.sh"
FORMULA=${RECIPE:-$ROOT/recipes/core-recipe-v0.1.md}

usage() {
  cat <<'EOF'
cookie - build a batch from a recipe's LOD0 table

  cookie                 interactive, it asks the questions
  cookie 100             one 100 g raw cookie
  cookie 80 -n 13        13 cookies of 80 g (1040 g of dough)
  cookie 100 -b          100 g is the baked weight (b1 measured 80 raw -> 70 baked)
  cookie 100 -c 30g      30 g of chocolate for the whole batch
  cookie 100 -c 40       chocolate as a percent of the dough (default 40)
  RECIPE=recipes/vegan.md bin/cookie 100   same math, another recipe
  cookie --selftest      check that the doc percentages sum to 100 and the math holds

Rows are rounded to 0.1 g; the Total line is exact.
EOF
}

die() {
  printf 'cookie: %s\n' "$*" >&2
  exit 1
}

# render <total dough g> <chocolate: 40 or 30g> <title>
# Chocolate rows split the chocolate share by their own ratio; everything else
# is scaled so the batch lands exactly on <total>.
render() {
  printf '%s\n' "$ROWS" | awk -v T="$1" -v choc="$2" -v title="$3" '
    {
      pct[NR] = $NF
      name[NR] = $0
      sub(/[ \t]+[^ \t]+$/, "", name[NR])
      if (tolower(name[NR]) ~ /chocolate/) { choc_pct += $NF; is_choc[NR] = 1 }
      else non_choc_pct += $NF
    }
    END {
      if (choc_pct == 0) {
        # no chocolate rows: -c is meaningless, scale the whole table to T
        choc_g = 0
        rest = T
      } else {
        if (choc ~ /g$/) { sub(/g$/, "", choc); choc_g = choc + 0 }
        else choc_g = T * (choc + 0) / 100
        rest = T - choc_g
      }
      if (T <= 0 || rest < 0) {
        printf "cookie: bad weight or chocolate amount (more chocolate than dough)\n" > "/dev/stderr"
        exit 1
      }
      printf "%s\n", title
      printf "%-30s %8s %9s\n", "ingredient", "%", "g"
      sum = 0
      for (i = 1; i <= NR; i++) {
        if (is_choc[i]) g = choc_g * pct[i] / choc_pct
        else g = rest * pct[i] / non_choc_pct
        sum += g
        printf "%-30s %7.1f%% %8.1fg\n", name[i], g * 100 / T, g
      }
      printf "%-30s %7.1f%% %8.1fg\n", "Total", sum * 100 / T, sum
    }'
}

selftest() {
  fail=0
  t=$(printf '%s\n' "$ROWS" | awk '{ s += $NF } END { printf "%.1f", s }')
  if [ "$t" != "100.0" ]; then
    printf 'FAIL: LOD0 percentages sum to %s, expected 100.0\n' "$t" >&2
    fail=1
  fi

  out=$(render 100 40 "test")
  if ! printf '%s\n' "$out" | awk '$1 == "Total" { ok = ($NF == "100.0g") } END { exit !ok }'; then
    printf 'FAIL: 100 g batch with 40%% chocolate did not total 100.0 g\n' >&2
    fail=1
  fi
  if ! printf '%s\n' "$out" | grep -Eq 'Flour \(all-purpose\)[[:space:]]+18\.0%[[:space:]]+18\.0g'; then
    printf 'FAIL: flour should be 18%% of a 100 g batch\n' >&2
    fail=1
  fi

  out=$(render 100 30g "test")
  if ! printf '%s\n' "$out" | awk '
      tolower($0) ~ /chocolate/ { v = $NF; sub(/g$/, "", v); s += v }
      $1 == "Total" { ok = ($NF == "100.0g" && sprintf("%.1f", s) == "30.0") }
      END { exit !ok }'; then
    printf 'FAIL: 30 g fixed chocolate should give 30.0 g chocolate and 100.0 g total\n' >&2
    fail=1
  fi

  # a recipe with no chocolate rows must ignore -c and still total T
  tmp=$(mktemp)
  printf '%s\n' '# TEST' '' '| Ingredient | % |' '|------------|--:|' \
    '| Sugar | 60% |' '| Water | 40% |' >"$tmp"
  saved=$ROWS
  ROWS=$(formula "$tmp")
  out=$(render 100 40 "test")
  ROWS=$saved
  rm -f "$tmp"
  if ! printf '%s\n' "$out" | awk '$1 == "Total" { ok = ($NF == "100.0g") } END { exit !ok }'; then
    printf 'FAIL: a recipe without chocolate should ignore -c and total 100.0 g\n' >&2
    fail=1
  fi

  # end to end, flags after the weight: 13 x 80 g with 30 g of chocolate for the batch
  out=$("$0" 80 -n 13 -c 30g)
  if ! printf '%s\n' "$out" | awk '
      tolower($0) ~ /chocolate/ { v = $NF; sub(/g$/, "", v); s += v }
      $1 == "Total" { ok = ($NF == "1040.0g" && sprintf("%.1f", s) == "30.0") }
      END { exit !ok }'; then
    printf 'FAIL: 13 x 80 g with -c 30g should total 1040.0 g with 30.0 g chocolate\n' >&2
    fail=1
  fi

  if [ "$fail" -eq 0 ]; then
    printf 'ok: formula sums to 100, 100 g and 30g-chocolate batches both check out\n'
  fi
  return "$fail"
}

[ -r "$FORMULA" ] || die "cannot read $FORMULA"
ROWS=$(formula "$FORMULA")
[ -n "$ROWS" ] || die "no percentages found in the LOD0 table of $FORMULA"

case ${1:-} in
  --selftest)
    selftest
    exit $?
    ;;
  -h | --help)
    usage
    exit 0
    ;;
esac

count=''
choc=40
baked=no
weight=''

# manual parse so flags work before or after the weight (getopts stops at positionals)
while [ $# -gt 0 ]; do
  case $1 in
    -n | -c)
      [ $# -ge 2 ] || die "$1 needs a value"
      if [ "$1" = -n ]; then count=$2; else choc=$2; fi
      shift 2
      ;;
    -n*) count=${1#-n}; shift ;;
    -c*) choc=${1#-c}; shift ;;
    -b) baked=yes; shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option $1" ;;
    *)
      weight=$1
      shift
      ;;
  esac
done

if [ -z "$weight" ]; then
  # interactive
  if [ -z "$count" ]; then
    ask 'How many cookies? [1] ' 1
    count=$REPLY
  fi
  ask 'Weight per cookie in grams? [80] ' 80
  weight=$REPLY
  ask 'Is that weight raw (before baking) or baked? [raw] ' raw
  case $REPLY in
    baked | b | B) baked=yes ;;
  esac
  ask 'Chocolate: percent of dough or grams (40 or 30g)? [40] ' "$choc"
  choc=$REPLY
fi
[ -n "$count" ] || count=1

isnum "$count" || die "cookie count must be a number, got '$count'"
isnum "$weight" || die "weight must be a number of grams, got '$weight'"
case $choc in
  '' | *[!0-9.g]*) die "chocolate must be like 40 or 30g, got '$choc'" ;;
esac
isnum "${choc%g}" || die "chocolate must be like 40 or 30g, got '$choc'"

note=''
if [ "$baked" = yes ]; then
  # shortcut: b1 measured 80 g raw -> 70 g baked; recalibrate when b2 is weighed
  weight=$(awk -v g="$weight" 'BEGIN { printf "%.1f", g / 0.875 }')
  note="baked weight converted to $weight g raw (b1 ratio 80 raw -> 70 baked)"
fi

total=$(awk -v w="$weight" -v n="$count" 'BEGIN { printf "%.1f", w * n }')
title=$(printf 'CORE - %s cookie(s) x %s g raw = %s g dough' "$count" "$weight" "$total")

render "$total" "$choc" "$title"
if [ -n "$note" ]; then
  printf '%s\n' "$note"
fi
